# Copy to .env.local and edit.

# mock (default) — seeded in-memory data, no backend required
# live           — calls the Spring backend at VITE_API_BASE_URL
VITE_DATA_MODE=mock

VITE_API_BASE_URL=http://146.190.224.202:8080/api

# Required only for /api/admin/** (employee management).
VITE_ADMIN_KEY=

# Simulated latency for mock responses, in ms.
VITE_MOCK_LATENCY_MS=220
