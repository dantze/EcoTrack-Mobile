# =========================================================================
# EcoTrack Backend Local/Dev Environment Variables (.env)
# Copy this file to backend/.env when running locally with bootRun
# =========================================================================

# --- Database (PostgreSQL) Configuration (Used only with --spring.profiles.active=prod) ---
DB_NAME=damiprod
DB_USER=damiprod_user
DB_PASS=replace_with_strong_password_here
DB_PORT=5432
DB_HOST=localhost

# --- DigitalOcean Spaces (S3-compatible storage for photos) ---
DO_SPACES_ACCESS_KEY=your_do_spaces_access_key
DO_SPACES_SECRET_KEY=your_do_spaces_secret_key
DO_SPACES_BUCKET=dami-prod-storage
DO_SPACES_REGION=fra1

# --- Security & Auth Enforcement ---
ECOTRACK_SECURITY_ENFORCE=true
ECOTRACK_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Google Sign-In (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=
