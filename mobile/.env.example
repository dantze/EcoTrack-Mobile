# Copy to mobile/.env (gitignored) and fill in. Names only — no values here.
#
# Expo inlines EXPO_PUBLIC_* when the BUNDLER runs, so this is baked into the JS:
# it is public by construction. Anything that must stay secret does not belong in
# this file or in this app.
#
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY used to live here. TODO-33 deleted the Sales
# section, and with it the only map and the only address lookup this app had, so
# nothing reads the key any more — see TODO-72 for revoking it in Google Cloud,
# which is the half that stops it billing.

# Which backend the build talks to, read by constants/ApiConfig.ts. Unset — or
# set to an empty string — it falls back to http://localhost:8080/api, which is
# right for a developer running `docker compose` and obviously wrong anywhere
# else. Production is the Cloud Run URL plus /api, from Terraform's
# backend_api_base_url output; deploy-mobile.yml refuses to ship without it,
# because an OTA re-bundles this value onto every installed phone.
#
# It also decides whether the Android build permits cleartext HTTP (TODO-85):
# app.config.js turns the exemption on only when this URL is http://, so a
# production build against Cloud Run has it off and a local build against
# compose or a LAN address has it on.
EXPO_PUBLIC_API_BASE_URL=https://your-service-hash.europe-west1.run.app/api

# Where the web app lives, printed by app/office.tsx — the screen an employee
# with only SALES or TECH lands on. Terraform's `frontend_url` output, or a
# custom domain from `web_custom_domains`.
#
# It is a SECOND variable, not the one above with /api removed, because the SPA
# and the API are on different origins since TODO-71 (TODO-84). Unset, that
# screen says it does not know the address rather than guessing — deploy-mobile.yml
# warns but still ships, since nothing a driver does depends on it.
EXPO_PUBLIC_WEB_APP_URL=https://your-project.vercel.app
