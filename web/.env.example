# Copy to .env.local and edit.

# mock (default) — seeded in-memory data, no backend required
# live           — calls the Spring backend at VITE_API_BASE_URL
VITE_DATA_MODE=mock

# Local dev against a backend on your machine or the VPS. In production this is
# the relative "/api" instead (same-origin behind Caddy) — see web/Dockerfile.
VITE_API_BASE_URL=http://localhost:8080/api

# Google OAuth client id for "Continuă cu Google" (Google Identity Services).
# Leave unset in live mode to hide the Google button entirely. Mock mode
# ignores this — it signs the Google button in as a seeded demo user without
# ever loading Google's script.
VITE_GOOGLE_CLIENT_ID=

# Simulated latency for mock responses, in ms.
VITE_MOCK_LATENCY_MS=220
